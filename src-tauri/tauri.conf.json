{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aetherwave",
  "version": "0.1.0",
  "identifier": "com.aetherwave.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "aetherwave",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "C:/Program Files (x86)/Steam/steamapps/workshop/content/431960/**",
          "C:/SteamLibrary/steamapps/workshop/content/431960/**",
          "D:/SteamLibrary/steamapps/workshop/content/431960/**",
          "D:/Steam/steamapps/workshop/content/431960/**",
          "D:/Games/SteamLibrary/steamapps/workshop/content/431960/**",
          "E:/SteamLibrary/steamapps/workshop/content/431960/**",
          "F:/SteamLibrary/steamapps/workshop/content/431960/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
